# Installed as /etc/terminal/api.env (mode 600, owner terminal).
API_HOST=127.0.0.1
API_PORT=8080
TERMINAL_DATA=/var/lib/terminal
TERMINAL_SAMPLES=/opt/terminal/samples
# Required in production: the exact tag sandbox/tag.sh prints (circuits rev + hash of sandbox/),
# which deploy.sh checks. The built-in default (terminal-sandbox:<circuits rev>) is for development.
TERMINAL_SANDBOX_IMAGE=terminal-sandbox:<output of sandbox/tag.sh>
TERMINAL_MAX_PROGRAM_WORDS=65535
TERMINAL_MAX_CONCURRENT_BUILDS=2
TERMINAL_MAX_CONCURRENT_RUNS=4
TERMINAL_DATA_CAP_GB=20
# nginx sets X-Forwarded-For to the single client hop; the api rate-limits on the last hop.
TRUST_PROXY=true
# Per-IP rate limits (defaults: 10 jobs/min, 60 runs/min, 6000 debugger reads under /runs/ per
# min, 600 other requests/min); uncomment to override.
#TERMINAL_JOBS_RPM=10
#TERMINAL_RUNS_RPM=60
#TERMINAL_RUNS_GET_RPM=6000
#TERMINAL_API_RPM=600
# Queue bounds: unfinished jobs per client and in total (503/429 beyond them).
#TERMINAL_MAX_ACTIVE_JOBS_PER_IP=3
#TERMINAL_MAX_QUEUED_JOBS=32
